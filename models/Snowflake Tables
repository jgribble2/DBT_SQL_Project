USE DATABASE DEMO;

CREATE SCHEMA IF NOT EXISTS DEMO.raw;

CREATE OR REPLACE TABLE DEMO.raw.orders (
    ordr_id NUMBER,
    cust_id NUMBER,
    produkt_id NUMBER,
    dt_id NUMBER,
    statsus VARCHAR,
    qty NUMBER,
    rev NUMBER
);

CREATE OR REPLACE TABLE DEMO.raw.customers (
    cust_id NUMBER,
    cust_name VARCHAR,
    cust_region VARCHAR
);

CREATE OR REPLACE TABLE DEMO.raw.products (
    product_id NUMBER,
    product_name VARCHAR,
    product_category VARCHAR
);

CREATE OR REPLACE TABLE DEMO.raw.dates (
    date_id NUMBER,
    date_year NUMBER,
    date_month NUMBER,
    date_day NUMBER
);

